# Node (no trailing slash: kong makes node_modules and .venv SYMLINKS, which git
# treats as files, so `node_modules/` alone let them be committed)
node_modules
dist/

# Python
__pycache__/
*.pyc
.venv

# Rust
target/

# KONG generated (do not ignore lockfiles — kong rules needs them)
kong.rules
.cargo/

# OS
.DS_Store
Thumbs.db
